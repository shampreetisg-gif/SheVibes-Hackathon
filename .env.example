# ==========================================
# CampusSync Local & External Server Config
# ==========================================

# 1. Database Connection (PostgreSQL)
# Copy this file to .env and set your PostgreSQL connection string.
# Supports any external database provider (Supabase, Neon, Railway, AWS RDS, ElephantSQL) or local PostgreSQL instance.
# Example: postgresql://postgres:yourpassword@db.supabase.co:5432/campussync?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/campussync

# 2. API Server Port
# Port for the Express API server (default: 5000)
PORT=5000

# 3. Base Path
# Base URL path for serving the application (default: /)
BASE_PATH=/

# 4. Target API URL for Frontend Proxying
# Url of the backend API server. If running frontend and backend on localhost, leave as http://localhost:5000.
# If connecting frontend to an external API server, set it to your remote server URL (e.g. https://api.campussync.com).
VITE_API_URL=http://localhost:5000
